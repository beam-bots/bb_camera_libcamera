# Stands in for `rpicam-vid --list-cameras`, replaying what a Pi 5 with two
# imx219s printed while the first was capturing in another process - which is
# why its modes are unreadable.

if [ "$1" != "--list-cameras" ]; then
  echo "fake_rpicam_vid only lists cameras" >&2
  exit 64
fi

cat <<'LISTING'
Available cameras
-----------------
